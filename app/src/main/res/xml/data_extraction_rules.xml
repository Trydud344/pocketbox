<?xml version="1.0" encoding="utf-8"?>
<!-- The rootfs, logs and credentials are device-local only; exclude them
     from cloud backup / device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="rootfs/" />
        <exclude domain="root" path="logs/" />
        <exclude domain="root" path="fake_proc/" />
        <exclude domain="root" path="runtime-state.json" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="rootfs/" />
        <exclude domain="root" path="logs/" />
        <exclude domain="root" path="fake_proc/" />
        <exclude domain="root" path="runtime-state.json" />
    </device-transfer>
</data-extraction-rules>
